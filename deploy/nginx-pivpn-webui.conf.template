# Installed to /etc/nginx/sites-available/pivpn-webui by
# deploy/setup-nginx-tls.sh (with __SERVER_NAME__ substituted), then
# symlinked into sites-enabled. Terminates TLS and reverse-proxies to
# gunicorn, which stays bound to 127.0.0.1 (see BIND_HOST in .env) —
# nginx is the only thing meant to be reachable from outside the box.
server {
    listen 443 ssl;
    server_name __SERVER_NAME__;

    ssl_certificate     /etc/nginx/ssl/pivpn-webui.crt;
    ssl_certificate_key /etc/nginx/ssl/pivpn-webui.key;
    ssl_protocols       TLSv1.2 TLSv1.3;

    location / {
        proxy_pass http://127.0.0.1:8443;
        # $http_host, not $host: $host strips the port, but if this server
        # sits behind a relay that exposes it on a non-default port (see
        # "Real client IPs behind a relay" below for the relay setup itself
        # — this is a separate concern from that), a browser's Referer on
        # every POST includes that port (e.g. https://relay:9443/...).
        # Flask-WTF's CSRF check (WTF_CSRF_SSL_STRICT, on by default)
        # compares Referer against the request's own Host — stripping the
        # port here would mismatch it and fail every POST, including
        # login, with a CSRF 400. $http_host preserves whatever the
        # browser actually sent, so it always matches. Identical to $host
        # for a plain default-port deployment (browsers omit the port from
        # the Host header when it's the scheme's default), so this is safe
        # either way.
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;

        # This panel has one-click destructive POST actions (delete a
        # firewall rule, revoke/block a client) — nothing here legitimately
        # needs to be framed by another site, so deny it outright rather
        # than risk a clickjacking overlay tricking a logged-in admin into
        # an action they didn't mean to take. `always` matters: without it
        # nginx only adds these on certain status codes, not on 4xx/5xx.
        add_header X-Frame-Options "DENY" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header Referrer-Policy "same-origin" always;
    }
}
