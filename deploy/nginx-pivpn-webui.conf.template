# Installed to /etc/nginx/sites-available/pivpn-webui by
# deploy/setup-nginx-tls.sh (with __SERVER_NAME__ substituted), then
# symlinked into sites-enabled. Terminates TLS and reverse-proxies to
# gunicorn, which stays bound to 127.0.0.1 (see BIND_HOST in .env) —
# nginx is the only thing meant to be reachable from outside the box.
server {
    listen 443 ssl;
    server_name __SERVER_NAME__;

    ssl_certificate     /etc/nginx/ssl/pivpn-webui.crt;
    ssl_certificate_key /etc/nginx/ssl/pivpn-webui.key;
    ssl_protocols       TLSv1.2 TLSv1.3;

    location / {
        proxy_pass http://127.0.0.1:8443;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
    }
}
