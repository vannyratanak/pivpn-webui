# Installed to /etc/sudoers.d/pivpn-webui by setup.sh (with __USER__
# substituted). Deliberately scoped to exact binaries, not "ALL" — the app
# only ever calls these things as root, and never with shell-interpolated
# arguments (see app/privileged.py).
__USER__ ALL=(root) NOPASSWD: /usr/local/sbin/pivpn-webui-ccd-helper.sh
__USER__ ALL=(root) NOPASSWD: /usr/local/sbin/pivpn-webui-log-helper.sh
__USER__ ALL=(root) NOPASSWD: /usr/local/sbin/pivpn-webui-routes-helper.sh
__USER__ ALL=(root) NOPASSWD: /usr/local/sbin/pivpn-webui-client-script-helper.sh
__USER__ ALL=(root) NOPASSWD: /usr/sbin/iptables
__USER__ ALL=(root) NOPASSWD: /usr/sbin/iptables-save
__USER__ ALL=(root) NOPASSWD: /usr/sbin/netfilter-persistent
# persisted_rule_ids() reads the saved-rules snapshot back via this, as
# root, since the file is root:root 640 — without this grant it's always
# unreadable and the Saved column shows "Unsaved" even right after a
# successful Save Rules. Pinned to this one fixed path (matching
# PERSISTED_RULES_PATH's default, which setup.sh never overrides in .env)
# rather than a bare `/bin/cat` — the app only ever reads this one file,
# so there's no reason to also grant root-read of every other file on the
# box. If you set PERSISTED_RULES_PATH to something else in .env by hand,
# update this line (and re-run setup.sh) to match, or Save Rules will
# start failing silently (cat requires a password it can't provide).
__USER__ ALL=(root) NOPASSWD: /bin/cat /etc/iptables/rules.v4
# For the CD deploy workflow's forced-command SSH key (see setup-cd-deploy.sh
# and README) — scoped to restarting only this one service, nothing else
# systemctl can do.
__USER__ ALL=(root) NOPASSWD: /usr/bin/systemctl restart pivpn-webui
# Same forced-command key also needs to reinstall the 4 helper scripts above
# after every git pull — a plain `git pull` only updates files inside the
# repo checkout, it never touches /usr/local/sbin/ (only setup.sh does
# that), so without this grant a helper-script change would silently never
# take effect through the Deploy workflow even though it reports success.
# Source and destination are both fully pinned per script, not wildcarded.
__USER__ ALL=(root) NOPASSWD: /usr/bin/install -m 0750 -o root -g root __APP_DIR__/deploy/pivpn-webui-ccd-helper.sh /usr/local/sbin/pivpn-webui-ccd-helper.sh
__USER__ ALL=(root) NOPASSWD: /usr/bin/install -m 0750 -o root -g root __APP_DIR__/deploy/pivpn-webui-log-helper.sh /usr/local/sbin/pivpn-webui-log-helper.sh
__USER__ ALL=(root) NOPASSWD: /usr/bin/install -m 0750 -o root -g root __APP_DIR__/deploy/pivpn-webui-routes-helper.sh /usr/local/sbin/pivpn-webui-routes-helper.sh
__USER__ ALL=(root) NOPASSWD: /usr/bin/install -m 0750 -o root -g root __APP_DIR__/deploy/pivpn-webui-client-script-helper.sh /usr/local/sbin/pivpn-webui-client-script-helper.sh
# /usr/local/bin/pivpn itself doesn't need sudo to invoke — but it internally
# runs each real subcommand as `sudo /opt/pivpn/openvpn/<script>.sh`, and
# those inner sudo calls are what actually need this grant. On Raspberry Pi
# OS the default 'pi' user already has NOPASSWD sudo out of the box, which is
# why this normally isn't needed; on a generic Debian/Ubuntu box (no such
# default) the web UI's non-interactive systemd service has no TTY to answer
# a sudo password prompt, so every add/list/revoke call fails outright
# without this. /opt/pivpn is root-owned and not writable by __USER__, so
# this wildcard can't be used to sudo arbitrary attacker-planted scripts.
__USER__ ALL=(root) NOPASSWD: /opt/pivpn/*.sh, /opt/pivpn/openvpn/*.sh, /opt/pivpn/wireguard/*.sh
