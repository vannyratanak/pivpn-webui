# Generated automatically by setup.sh — copy this file's shape, don't hand-edit
# the hash unless you know what you're doing.

SECRET_KEY=changeme-generate-with-setup.sh
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=changeme-generate-with-setup.sh

# Where PiVPN writes finished client .ovpn files (PiVPN default is ~/ovpns)
PIVPN_OVPN_DIR=/home/pi/ovpns

# OpenVPN client-config-dir, used to pin a static IP per client so the
# per-client block/unblock firewall toggle has something stable to match on.
OPENVPN_CCD_DIR=/etc/openvpn/ccd

# First three octets of your OpenVPN subnet (PiVPN default is 10.8.0.0/24).
# Check `grep '^server ' /etc/openvpn/server.conf` if unsure.
OPENVPN_SUBNET_BASE=10.8.0

# Path to the root-helper scripts installed by setup.sh
CCD_HELPER=/usr/local/sbin/pivpn-webui-ccd-helper.sh
LOG_HELPER=/usr/local/sbin/pivpn-webui-log-helper.sh

# Bind to localhost by default. Use an SSH tunnel or a TLS reverse proxy
# for remote access — see README.md before changing this to 0.0.0.0.
BIND_HOST=127.0.0.1
BIND_PORT=8443
