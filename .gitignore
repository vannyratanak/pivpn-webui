venv/
.env
# Everything under instance/ is runtime state, not source: the db file,
# TLS certs/keys generated by setup-hub-tls.sh or for the web UI's own
# BIND_TLS_CERT (private keys must never be committed, especially to
# this public repo), lock files, and the hub/agent Unix socket.
instance/*
__pycache__/
*.pyc
